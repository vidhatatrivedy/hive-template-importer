# Credentials for sandboxed agent runs (npm run sandcastle).
# Copy to .sandcastle/.env (gitignored). You only need the provider(s) you run.

# --- Claude (--provider claude) ------------------------------------------------
# Subscription token: run `claude setup-token` on your host and paste it here.
CLAUDE_CODE_OAUTH_TOKEN=
# Or an Anthropic API key instead:
# ANTHROPIC_API_KEY=

# --- Cursor (--provider cursor) ------------------------------------------------
# https://cursor.com/dashboard -> Integrations -> API keys
CURSOR_API_KEY=

# --- GitHub Issues (always required) -------------------------------------------
# Fine-grained token scoped to vidhatatrivedy/hive-template-importer:
#   Issues: Read and write, Metadata: Read
# https://github.com/settings/personal-access-tokens/new
GH_TOKEN=
