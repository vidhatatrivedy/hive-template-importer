# App environment. Copy to .env.local (gitignored) and fill in from the
# Supabase dashboard of the dev project. .env.prod holds the prod project's
# SUPABASE_URL and SUPABASE_SECRET_KEY only.

# Project Settings -> API
SUPABASE_URL=
# Server-only secret key (sb_secret_…). Never expose to the browser.
SUPABASE_SECRET_KEY=

# --- Dev only: never set these for prod ----------------------------------------
# Postgres connection string for migrations and test:db (db:push, db:reset).
# Connect -> Session pooler (port 5432; the direct connection is IPv6-only and
# the transaction pooler can't run migrations). URL-encode the password.
SUPABASE_DB_URL=
# Publishable key (sb_publishable_…), read only by test:db's grants check.
# The app never reads it.
SUPABASE_PUBLISHABLE_KEY=
